APP_NAME=AlwaysHealthy
ENV=dev
DATABASE_URL=postgresql+asyncpg://alwayshealthy:alwayshealthy@localhost:5432/alwayshealthy
CHECKPOINTER=postgres
JWT_SECRET=change-this-before-demo
ACCESS_TOKEN_MINUTES=30
REFRESH_TOKEN_DAYS=14

LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=
LLM_MODEL=deepseek-chat
# 一次工作流最多跑多久（秒）。前端也有一条 180 秒的兜底线，这条要比它短，
# 否则断连时先由前端掐断、后端还在算，状态会卡在 running
WORKFLOW_TIMEOUT_SECONDS=150

EMBEDDING_BACKEND=keyword
BGE_MODEL_PATH=BAAI/bge-m3
CHROMA_DIR=storage/chroma
KNOWLEDGE_DIR=knowledge

STORAGE_DIR=storage
UPLOAD_MAX_MB=10
EMERGENCY_PHONE=120
