# 复制为 .env 后 docker compose 会自动读取，不要提交这份文件
# 数据库口令，改动后已有数据卷不会自动改密
POSTGRES_PASSWORD=alwayshealthy

# 必填，没有值 compose 会直接报错停下
JWT_SECRET=

# 模型接口，留空时降级到规则回答
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=
LLM_MODEL=deepseek-chat

# keyword 走本地检索，bge 需要先装 requirements-vector.txt 并起 chroma
EMBEDDING_BACKEND=keyword
EMERGENCY_PHONE=120

# 上传件与导出报告目录，相对 deployment 目录。改到 E 盘就写 E:/AngentDev/AlwaysHealthy/storage
STORAGE_DIR=../storage
