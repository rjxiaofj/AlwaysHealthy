# 环境配置模板。复制成本目录下的 .env 后填写，docker compose 会自动读取 .env
# .env 已在 .gitignore 里排除，真实密钥只留本机，不要提交
# 复制命令：Copy-Item .env.example .env

# Postgres 初始口令。只在数据卷第一次初始化时生效，之后改这里不会改已有库的密码
# 要改已有库的密码得进库执行 ALTER USER，或者删卷重建
POSTGRES_PASSWORD=alwayshealthy

# 必填。签发访问令牌与刷新令牌用的密钥，换掉等于让所有已发令牌失效
# 生成方式：python -c "import secrets; print(secrets.token_urlsafe(36))"
# 留空时 compose 直接报错停下；env=prod 下用默认值会被后端拒绝启动
JWT_SECRET=

# 模型接口。LLM_API_KEY 留空时后端降级到规则回答，不调外部模型
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=
LLM_MODEL=deepseek-chat

# 检索通道。keyword 走本地关键词匹配；bge 需要先装 backend/requirements-vector.txt 并起 chroma
EMBEDDING_BACKEND=keyword

# 高危提示里播报的急救电话，换地区要改
EMERGENCY_PHONE=120

# 上传件与导出报告的宿主机目录，映射到容器内的 /srv/storage
# 相对路径按 deployment 目录算。要放别的盘就写绝对路径，例如 E:/AngentDev/AlwaysHealthy/storage
STORAGE_DIR=../storage
